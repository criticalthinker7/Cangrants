# GEMINI_API_KEY is server-only and optional for local development.
# When set, it enables Gemini-backed AI responses; without it, the server uses
# the built-in fallback response.
# GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Stripe secrets are future/conditional and server-only. Leave unset unless
# payment flows are added.
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."
